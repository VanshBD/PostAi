# Environment Variables Template

# Base Application URL
# In local development: http://localhost:5173
# On Vercel: set this to your custom domain or https://your-project.vercel.app
VITE_APP_URL=http://localhost:5173

# MongoDB Atlas URI (Backend Database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.8rfhttn.mongodb.net/postai?retryWrites=true&w=majority&appName=Cluster0

# Groq API Key (Optional, for Llama 3 70B generation)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Optional, for Gemini 1.5 Flash generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
